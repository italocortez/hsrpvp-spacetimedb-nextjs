# SpacetimeDB connection (used by both client and server)
NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=your-database-name

# Server-side SpacetimeDB (non-NEXT_PUBLIC — not exposed to client)
SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=your-database-name

# Server identity token — generated by: npx tsx scripts/register-server.ts
# This is the SpacetimeDB auth token for the trusted "Server" identity.
# DO NOT commit this value. Add it only to .env.local.
SPACETIMEDB_SERVER_TOKEN=

# Discord OAuth (NextAuth)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
