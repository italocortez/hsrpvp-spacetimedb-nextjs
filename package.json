{
  "name": "hsrpvp-spacetimedb-nextjs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate": "npm --prefix spacetimedb install && cargo run -p gen-bindings -- --out-dir src/module_bindings --module-path spacetimedb && prettier --write src/module_bindings",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:publish:local": "spacetime publish --module-path spacetimedb --server local",
    "spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud",
    "spacetime:publish:migrate": "spacetime publish --module-path spacetimedb --server maincloud --yes=migrate",
    "test": "vitest run --config test/vitest.config.ts",
    "test:watch": "vitest --config test/vitest.config.ts",
    "test:integration": "vitest run --config test/vitest.integration.config.ts",
    "test:integration:watch": "vitest --config test/vitest.integration.config.ts",
    "test:all": "vitest run --config test/vitest.config.ts && vitest run --config test/vitest.integration.config.ts",
    "test:phase": "vitest run --config test/vitest.integration.config.ts --dir",
    "test:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroui/button": "^2.2.32",
    "@heroui/chip": "^2.2.25",
    "@heroui/input": "^2.4.33",
    "@heroui/modal": "^2.2.29",
    "@heroui/select": "^2.4.33",
    "@heroui/system": "^2.4.28",
    "@heroui/table": "^2.2.32",
    "@heroui/tabs": "^2.2.29",
    "@heroui/theme": "^2.4.26",
    "@tailwindcss/postcss": "^4.2.1",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "framer-motion": "^12.35.2",
    "next": "^15.5.0",
    "next-auth": "^4.24.13",
    "postcss": "^8.5.8",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "spacetimedb": "^2.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "typescript": "~5.6.2",
    "vitest": "^4.1.0",
    "ws": "^8.20.0"
  }
}
